# 服务监听地址；默认仅监听本机回环地址。命令行 --listen 的优先级更高。
# listen = "127.0.0.1:9527"

# 字符串模式：执行请求省略 cwd 时，默认使用此目录。
# 数组模式：允许多个根目录，此时执行请求必须提供绝对 cwd，上传和下载也必须使用绝对路径。

# work_dir = "."
# work_dir = ['D:\WorkspaceA', 'D:\WorkspaceB']

# 是否允许请求通过 require_admin = true 触发 UAC；默认关闭。
# allow_elevation = false

# 普通字符串按忽略大小写的调用前缀匹配；使用 /.../ 包裹的值按忽略大小写的正则表达式匹配。
# 启用后会仅允许使用 cmd，并严格要求通过 program + args 的形式调用
# command_allowlist = [
#   "notepad.exe ",
#   "WimBuilder.cmd", # work_dir 中同名的 .cmd/.bat 可直接按文件名运行
#   '/^git(\.exe)? "status"$/',
#   '/^cargo(\.exe)? "(check|test)"/',
# ]
